  "info": {
    "title": "Hoard API",
    "description": "Epic memory augmentation app!",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Role_Output": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ],
        "id": "Role_Output"
      },
      "LlmProvider_Output": {
        "type": "string",
        "enum": [
          "ANTHROPIC",
          "GOOGLE_GEMINI",
          "PLATFORM"
        ],
        "id": "LlmProvider_Output"
      },
      "Graph_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "description",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "id": "Graph_Output"
      },
      "UserWithoutPasswordDto_Output": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "default": "USER",
            "$ref": "#/components/schemas/Role_Output"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "activeLlmProvider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LlmProvider_Output"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "graphs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Graph_Output"
            }
          }
        },
        "required": [
          "email",
          "role",
          "id",
          "activeLlmProvider",
          "createdAt",
          "updatedAt",
          "graphs"
        ],
        "additionalProperties": false
      },
      "UpdateSelf": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 5,
            "maxLength": 60
          },
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "currentPassword"
        ],
        "id": "UpdateSelf"
      },
      "DeleteSelf": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "confirmationText": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "confirmationText"
        ],
        "id": "DeleteSelf"
      },
      "Role": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ],
        "id": "Role"
      },
      "CreateUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 5,
            "maxLength": 60
          },
          "role": {
            "default": "USER",
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "password"
